{
  "root": true,
  "parser": "@babel/eslint-parser",
  "parserOptions": {
    "requireConfigFile": false,
    "babelOptions": {
      "parserOpts": {
        "plugins": [
          "classProperties",
          ["decorators", { "decoratorsBeforeExport": false }]
        ]
      }
    }
  },
  "env": {
    "browser": true
  },
  "plugins": ["promise"],
  "extends": ["eslint:recommended", "plugin:import/recommended", "prettier"],
  "rules": {
    "no-return-assign": "off",
    "consistent-return": "warn",
    "no-await-in-loop": "warn",
    "no-prototype-builtins": "warn",
    "import/no-duplicates": "error",
    "no-console": ["error", { "allow": ["warn", "error"] }],
    "no-self-compare": "error",
    "no-template-curly-in-string": "error",
    "no-unreachable-loop": "error",
    "camelcase": [
      "warn",
      { "ignoreImports": true, "allow": ["[A-Z]{2,3}_[a-zA-Z]*"] }
    ],
    "curly": "error",
    "max-depth": ["error", 5],
    "max-params": ["error", 5],
    "no-inline-comments": "warn",
    "no-lonely-if": "error",
    "no-nested-ternary": "warn",
    "no-useless-return": "error"
  },
  "globals": {
    "$": true,
    "$A": true,
    "AuraContext": true,
    "AuraSerializationService": true,
    "AuraExpressionService": true,
    "AuraEventService": true,
    "AuraLocalizationService": true,
    "AuraStorageService": true,
    "AuraStyleService": true,
    "MetricsService": true,
    "AuraDevToolService": true,
    "Component": true,
    "FORCE": true,
    "moment": true,
    "exports": true,
    "iScroll": true,
    "unescape": true,
    "Promise": true
  }
}
