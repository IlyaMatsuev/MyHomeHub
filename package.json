{
  "name": "my-smart-home",
  "private": true,
  "version": "1.0.0",
  "description": "Contains scripts and logic for microcontrollers used for my Smart Home setup",
  "scripts": {
    "prepare": "husky",
    "lint-staged": "lint-staged",
    "prettier": "prettier --write",
    "prettier:verify": "prettier --list-different",
    "eslint": "eslint --fix",
    "eslint:verify": "eslint --quiet",
    "hub:start": "cd ./src/hub && npm run start",
    "hub:start:dev": "cd ./src/hub && npm run start:dev",
    "hub:start:debug": "cd ./src/hub && npm run start:debug",
    "hub:start:prod": "cd ./src/hub && npm run start:prod"
  },
  "author": {
    "name": "Ilya Matsuev",
    "email": "ilya.matsuev.personal@gmail.com",
    "url": "https://github.com/IlyaMatsuev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/IlyaMatsuev"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.25.8",
    "@prettier/plugin-xml": "^3.4.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-promise": "^7.1.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3"
  },
  "lint-staged": {
    "**/*.{html,js,ts,css,xml,yaml,yml,json,md}": [
      "npm run prettier"
    ],
    "**/*.{js,ts}": [
      "npm run eslint"
    ]
  },
  "dependencies": {
    "swagger-themes": "^1.4.3"
  }
}
