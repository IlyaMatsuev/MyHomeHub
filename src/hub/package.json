{
  "name": "my-smart-home-hub",
  "version": "0.0.1",
  "description": "",
  "private": true,
  "engines": {
    "npm": ">=10.0.0",
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "nest build",
    "build:image": "npm run build && docker compose -f docker-compose.yaml build smarthome-hub-server",
    "start": "npm run build && NODE_ENV=local nest start",
    "start:dev": "nest build && NODE_ENV=local nest start --watch",
    "start:prod": "docker compose -f docker-compose.prod.yaml up smarthome-hub-server-prod",
    "mongo:start": "docker compose -f docker-compose.yaml up -d mongodb",
    "mongo:start:prod": "docker compose -f docker-compose.prod.yaml up -d mongodb-prod",
    "mqtt:start": "docker compose -f docker-compose.yaml up -d mqtt-broker",
    "mqtt:start:prod": "docker compose -f docker-compose.prod.yaml up -d mqtt-broker-prod",
    "watcher:start": "docker compose -f docker-compose.prod.yaml up -d smarthome-hub-server-image-watcher",
    "watcher:start:once": "docker compose -f docker-compose.prod.yaml up smarthome-hub-server-image-watcher-once && docker compose -f docker-compose.prod.yaml rm smarthome-hub-server-image-watcher-once -fsv",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.13",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.13",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/microservices": "^11.0.17",
    "@nestjs/platform-express": "^11.0.13",
    "@nestjs/platform-ws": "^11.0.13",
    "@nestjs/schedule": "^5.0.1",
    "@nestjs/swagger": "^11.1.1",
    "@nestjs/websockets": "^11.0.13",
    "argon2": "^0.41.1",
    "castv2-promise": "^1.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "color": "^5.0.0",
    "cron-validator": "^1.3.1",
    "gaxios": "^6.7.1",
    "google-tts-api": "^0.0.6",
    "mongoose": "^8.9.4",
    "mqtt": "^5.11.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "speakeasy": "^2.0.0",
    "suncalc": "^1.9.0",
    "swagger-themes": "^1.4.3",
    "tuyapi": "^7.7.1",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^11.0.13",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.3.1",
    "@types/speakeasy": "^2.0.10",
    "@types/suncalc": "^1.9.2",
    "@types/supertest": "^6.0.0",
    "@types/ws": "^8.5.13",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
