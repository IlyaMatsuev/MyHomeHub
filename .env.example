# Server
SERVER_LABEL=My Home Hub
PORT=3000
NODE_ENV=local
LOG_LEVEL=debug
TZ=Europe/Amsterdam
TZ_LATITUDE=52.3676
TZ_LONGITUDE=4.9041
# Reverse proxy support used to resolve the real client IP from the X-Forwarded-For header.
# Accepts: false, true (trusts any client), the number of proxies in front of the server,
# or a comma-separated list of trusted proxy addresses/subnets (e.g. loopback,192.168.0.0/16)
TRUST_PROXY=false
# Comma-separated list of allowed CORS origins (e.g. https://home.example.com,https://app.example.com).
# When empty, CORS is allow-all (a warning is logged when NODE_ENV=prod). When set, credentials are allowed too.
CORS_ORIGINS=

# Device Configs
# Optional: Directory with yaml device config files (relative to the cwd or absolute). Defaults to "configs/devices"
# DEVICE_CONFIGS_DIR=configs/devices

# Server Discovery
UDP_PORT=45353
DISCOVERY_MESSAGE=MY_HOME_HUB_DISCOVER
# Optional: Override the server address returned by /info endpoint (useful for Docker or reverse proxy setups)
# SERVER_EXTERNAL_ADDRESS=192.168.1.1
# Optional: Override the port returned by /info endpoint (useful for reverse proxy setups)
# SERVER_EXTERNAL_PORT=443

# Rate Limiting
THROTTLE_ENABLED=true
THROTTLE_SHORT_TTL_SEC=1
THROTTLE_SHORT_LIMIT=3
THROTTLE_MEDIUM_TTL_SEC=10
THROTTLE_MEDIUM_LIMIT=20
THROTTLE_LONG_TTL_SEC=60
THROTTLE_LONG_LIMIT=100

# Auth
ENABLE_LOCAL_AUTH=false
REGISTRATION_TOTP_SECRET=1234567890
USER_PASSWORD_SECRET=2487jewfkb
USER_PASSWORD_SALT=282sa123jf
# Access Token (1 hour)
JWT_SECRET=AAAAAAAAAAAAAA
JWT_EXPIRATION_TIMEOUT=3600
# Refresh Token (7 days)
JWT_REFRESH_SECRET=BBBBBBBBBBBBBB
JWT_REFRESH_EXPIRATION_TIMEOUT=604800
# Password Reset Token TTL in Redis (5 minutes)
PASSWORD_RESET_TOKEN_TTL_SEC=300
# Optional: the OAuth client ID(s) of the hub client apps (WEB, IOS, ANDROID), used as the audience the Google ID tokens are verified against.
# Accepts a comma-separated list, since Google issues a separate client ID per platform.
# When empty, the Google authentication endpoints respond with 503
GOOGLE_CLIENT_ID=

# MongoDB
MONGO_DOMAIN=127.0.0.1
MONGO_PORT=27017
MONGO_INITDB_DATABASE=smarthome
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=password
MONGO_CONTAINER_NAME=mongodb

# Redis
REDIS_KEY_PREFIX=hub
REDIS_DOMAIN=127.0.0.1
REDIS_PORT=6379

# MQTT Broker
MQTT_DOMAIN=127.0.0.1
MQTT_CLIENT_ID=my-home-hub
MQTT_CLIENT_SENDER_ID=my-home-hub-sender
MQTT_PORT=1885
MQTT_USERNAME=ilyamatsuev
MQTT_PASSWORD=password

# Zigbee2MQTT
Z2M_FRONT_END_PORT=1886
Z2M_MQTT_DOMAIN=mqtt-broker
Z2M_MQTT_USERNAME=z2m_mqtt_username
Z2M_MQTT_PASSWORD=z2m_mqtt_password
# "GENERATE" means these variables will be automatically generated and updated in the .env file by /scripts/generate_z2m_secrets.js
# Any other value will be treated as an actual value
Z2M_NETWORK_KEY=GENERATE
Z2M_PAN_ID=GENERATE
Z2M_EXT_PAN_ID=GENERATE

# Zigbee
# The path to the zigbee dongle device port. Can be checked with "ls -l /dev/serial/by-id/"
ZIGBEE_DONGLE_PATH=/dev/serial/by-id/usb-SONOFF_SONOFF_Dongle_Lite_MG21_xxxxxxxxxxxx-test-port0
