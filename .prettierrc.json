{
  "plugins": ["@prettier/plugin-xml"],
  "trailingComma": "all",
  "printWidth": 140,
  "tabWidth": 4,
  "semi": true,
  "singleQuote": true,
  "arrowParens": "avoid",
  "overrides": [
    {
      "files": "*.xml",
      "options": {
        "printWidth": 240,
        "bracketSameLine": true
      }
    },
    {
      "files": ["*.yml", "*.yaml", "*.json"],
      "options": {
        "printWidth": 80,
        "tabWidth": 2,
        "singleQuote": false
      }
    }
  ]
}
